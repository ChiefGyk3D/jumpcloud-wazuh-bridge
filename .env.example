# jumpcloud-wazuh-bridge environment file
#
# Copy to .env next to docker-compose.yml, fill in ONE of the secret options,
# and uncomment the env_file block in docker-compose.yml.
# Never commit the real .env file.

# --- Option 1: Doppler service token (recommended for production) ---
# Scoped service token; the bridge pulls all JUMPCLOUD_* secrets from Doppler.
#DOPPLER_TOKEN=dp.st.xxxx

# --- Option 2: Direct JumpCloud credentials ---
# Read-only Directory Insights API key.
#JUMPCLOUD_API_KEY=your-read-only-api-key
# Only needed for multi-tenant JumpCloud organizations.
#JUMPCLOUD_ORG_ID=

# --- Optional tuning (defaults shown) ---
#JUMPCLOUD_BASE_URL=https://api.jumpcloud.com
#JUMPCLOUD_SERVICES=all
#JUMPCLOUD_POLL_SECONDS=300
#JUMPCLOUD_LOOKBACK_MINUTES=15
#JUMPCLOUD_OUTPUT_FILE=/data/jumpcloud-events.jsonl
#JUMPCLOUD_STATE_FILE=/data/cursor.json
#JUMPCLOUD_PAGE_LIMIT=1000
